//Name, Major, Grad date, Job pref, experience, employment type, work location,
// country, company stages, industry, minimum pay, coding language, upload resume

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}
enum JobLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum WorkMode {
  REMOTE
  HYBRID
  IN_PERSON
};

enum PayPeriod {
  HOURLY
  YEARLY
}

// is this well defined? need to ask some questions
enum CompanyStage {

  EARLY_STAGE 
  STARTUP
  PUBLIC_TECH
  FAANG

}

model User {
  id          String     @id @default(cuid()) // User id
  email       String      @unique
  password    String
  firstName   String?
  lastName    String?

  profile   UserProfile? // This will be an object type that we define

  onboardingCompleted Boolean @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt  @default(now())
}


model UserProfile {
  id                String @id @default(cuid()) // id for profile
  userId            String @unique // refers back to user id
  user              User   @relation(fields: [userId], references: [id]) // one to one relation --> profile.userId to User.id

  major             String?
  graduationMonth   String?
  graduationYear    Int?
  skills            String[]
  codingLanguages   String[]

  jobLevels         JobLevel[]
  employmentTypes   EmploymentType[]
  workModes         WorkMode[]
  preferredLocations String[]

  companyStages     CompanyStage[]
  jobRoles          String[]
  industries        String[]

  minimumPay        Int?
  payPeriod         PayPeriod?

  resumeUrl         String?
}

